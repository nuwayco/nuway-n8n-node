{
  "name": "n8n-nodes-nuway",
  "version": "2.0.0",
  "description": "n8n node for the NUWAY public API: chat with your AI workers, read conversations, leads and meetings, and manage training knowledge",
  "author": "NUWAY",
  "license": "MIT",
  "homepage": "https://github.com/nuwayco/nuway-n8n-node",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nuwayco/nuway-n8n-node.git"
  },
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "nuway",
    "chatbot",
    "ai"
  ],
  "engines": {
    "node": ">=18.10"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/NuwayApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Nuway/Nuway.node.js"
    ]
  },
  "scripts": {
    "build": "node scripts/clean.js && tsc && node scripts/copy-icons.js",
    "dev": "tsc --watch",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "n8n-workflow": "1.120.10",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "form-data": "^4.0.6"
  }
}
